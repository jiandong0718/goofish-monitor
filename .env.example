# SQLite database path (relative to project root or absolute)
DATABASE_URL=sqlite:///./data/monitor.db

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai

# Collector backend: stub (safe default) | playwright (真采集 / 持久化配置)
COLLECTOR_BACKEND=stub
HTTPX_TIMEOUT=30

# Playwright / Goofish
GOOFISH_HEADLESS=true
GOOFISH_TIMEOUT_MS=30000
# Persistent Chromium profile (product login path; Cookie export often blocked)
# Default: data/browser_profile/
# GOOFISH_USER_DATA_DIR=data/browser_profile
# Optional legacy: operator Cookie header / file (prefer persistent profile)
# GOOFISH_COOKIES=cookie2=...; _m_h5_tk=...; ...
# GOOFISH_COOKIES_FILE=/path/to/goofish_cookies.txt
# Fixture mode for CI/smoke (no live 闲鱼 network):
# GOOFISH_FIXTURE_PATH=tests/fixtures/sample_listings.json
# Skip live session probe on /accounts (tests)
# GOOFISH_SKIP_PROBE=false

# ── AI analyzer（OpenAI 兼容 Chat Completions）────────────────
# 未设置 AI_API_KEY 时自动跳过 AI，仅规则评估写库
# AI_API_BASE=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# 默认仅对规则「推荐 / 待观察」调用 AI；设为 true 时连「不推荐」也调用（费 token）
# AI_ALWAYS=false

# ── 推送（推荐结论）────────────────────────────────────────
# 企业微信群机器人 Webhook，或任意接收 POST JSON 的 URL
# PUSH_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_KEY
# 可选 Telegram
# PUSH_TELEGRAM_BOT_TOKEN=
# PUSH_TELEGRAM_CHAT_ID=
# 默认仅推送「推荐」；设为 true 时「待观察」也推
# PUSH_INCLUDE_WATCH=false
